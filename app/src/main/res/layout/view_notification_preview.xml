<?xml version="1.0" encoding="utf-8"?>
<!-- Looks like the real notification, filled in by Preview.bind(). -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.Material3.CardView.Filled"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <!-- Chat style: the picture, once, on the left. -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/pvIcon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop"
            app:shapeAppearanceOverlay="@style/SquircleImage" />

        <!-- Classic style: the app's small icon on the left... -->
        <ImageView
            android:id="@+id/pvAppIcon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_app_icon"
            android:importantForAccessibility="no"
            android:padding="10dp"
            android:src="@drawable/ic_notification"
            android:visibility="gone"
            app:tint="?attr/colorOnPrimaryContainer" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/pvHeader"
                style="@style/Hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1" />

            <TextView
                android:id="@+id/pvTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="?attr/textAppearanceTitleMedium" />

            <TextView
                android:id="@+id/pvBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnSurface" />
        </LinearLayout>

        <!-- ...and the picture on the right. -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/pvLarge"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="12dp"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop"
            android:visibility="gone"
            app:shapeAppearanceOverlay="@style/SquircleImage" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
